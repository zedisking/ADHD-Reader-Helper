{
  "name": "bionic-reader",
  "version": "1.0.0",
  "description": "Converts any webpage, URL, or uploaded file (opened in a tab) to **Bionic Reading** format for faster, more focused reading. Bionic Reading bolds the first portion of each word to create fixation points that help your eyes scan text more efficiently.",
  "main": "background.js",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const p=require('path');const d=p.join(__dirname,'lib');fs.mkdirSync(d,{recursive:true});fs.copyFileSync(p.join(__dirname,'node_modules','jszip','dist','jszip.min.js'),p.join(d,'jszip.min.js'));fs.copyFileSync(p.join(__dirname,'node_modules','pdfjs-dist','legacy','build','pdf.min.mjs'),p.join(d,'pdf.min.mjs'));fs.copyFileSync(p.join(__dirname,'node_modules','pdfjs-dist','legacy','build','pdf.worker.min.mjs'),p.join(d,'pdf.worker.min.mjs'));fs.copyFileSync(p.join(__dirname,'node_modules','mammoth','mammoth.browser.min.js'),p.join(d,'mammoth.min.js'));\"",
    "package": "node scripts/build-zip.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Damien Cresswell",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.624"
  },
  "devDependencies": {
    "archiver": "^7.0.1"
  }
}
